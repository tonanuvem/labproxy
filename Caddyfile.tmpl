# Template do Caddyfile. O proxy.sh troca __HOST__ pelo nome do aluno. O
# arquivo gerado (Caddyfile) nao e' versionado.
#
# Ver §3.1 e §4 do CONTEXTO.md. O roteamento por porta foi validado em §7.
#
# Nao ha autenticacao aqui. Ela vive no painel, porque o aluno liga e desliga
# a protecao pela pagina, e mexer neste arquivo em tempo de execucao exigiria
# o painel reescrevendo a config do Caddy e recarregando pela admin API. Como
# o Caddy ja consulta o painel a cada requisicao de porta, sai mais simples o
# painel ser a autoridade unica. Ver §5.

{
	admin off

	# A 80 e' do apache que ja roda no host da VM, e nao vai sair de la.
	# Sem isto o Caddy tenta montar o vhost de redirecionamento.
	auto_https disable_redirects
}

# ---------------------------------------------------------------------------
# <porta>.<aluno>.<zona>  ->  localhost:<porta> da VM
# ---------------------------------------------------------------------------
*.__HOST__ {
	tls /etc/caddy/cert.pem /etc/caddy/key.pem

	@porta header_regexp porta Host ^([0-9]{2,5})\.
	handle @porta {
		# O painel decide duas coisas de uma vez: se quem pede esta
		# autenticado (quando a protecao esta ligada) e se aquela porta pode
		# ser proxyada. Num 401 ou 403 o Caddy devolve a resposta do painel
		# como ela e', entao o WWW-Authenticate chega ao navegador.
		# Fail-closed: painel fora do ar significa nenhuma porta liberada.
		forward_auth painel:8000 {
			uri /_authz?porta={re.porta.1}
		}

		reverse_proxy host.docker.internal:{re.porta.1} {
			# Repassa o Host inalterado, que e' o padrao do Caddy. Apps que
			# validam Host (NiFi) precisam de ajuste — ver §8.
			header_up X-Labproxy-Porta {re.porta.1}
		}
	}

	handle {
		redir https://__HOST__/ 302
	}
}

# ---------------------------------------------------------------------------
# Nome base -> painel. Ele cuida da propria autenticacao.
# ---------------------------------------------------------------------------
__HOST__ {
	tls /etc/caddy/cert.pem /etc/caddy/key.pem
	reverse_proxy painel:8000
}
