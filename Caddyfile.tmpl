# Template do Caddyfile. O proxy.sh troca __HOST__ pelo nome do aluno. O
# arquivo gerado (Caddyfile) nao e' versionado.
#
# Desenho: painel em HTTPS, aplicacoes em HTTP. Ver §3.5 do CONTEXTO.md.
# O certificado passa a cobrir um nome so — o do painel — porque as portas
# nao sao mais servidas por TLS. Um SAN por turma, para sempre.

{
	admin off

	# As aplicacoes sao HTTP de proposito. Sem isto o Caddy redireciona
	# tudo para HTTPS e o desenho inteiro se desfaz.
	auto_https disable_redirects
}

# ---------------------------------------------------------------------------
# HTTPS, so o painel. Unico lugar que precisa de certificado.
# ---------------------------------------------------------------------------
https://__HOST__ {
	tls /etc/caddy/cert.pem /etc/caddy/key.pem
	reverse_proxy painel:8000
}

# ---------------------------------------------------------------------------
# HTTP: <porta>.<aluno>.<zona>  ->  localhost:<porta> da VM
# ---------------------------------------------------------------------------
http://*.__HOST__ {
	@porta header_regexp porta Host ^([0-9]{2,5})\.
	handle @porta {
		# O painel decide se quem pede esta autenticado (quando a protecao
		# esta ligada) e se a porta pode ser proxyada. Fail-closed.
		forward_auth painel:8000 {
			uri /_authz?porta={re.porta.1}
		}

		reverse_proxy host.docker.internal:{re.porta.1} {
			header_up X-Labproxy-Porta {re.porta.1}
		}
	}

	handle {
		redir https://__HOST__/ 302
	}
}

# ---------------------------------------------------------------------------
# HTTP no nome base: sobe para o painel, que e' HTTPS.
# ---------------------------------------------------------------------------
http://__HOST__ {
	redir https://__HOST__{uri} 301
}

# ---------------------------------------------------------------------------
# Qualquer outra coisa na 80 — o IP cru, nomes de fora da zona — recebe a
# pagina de atalhos que o apache da VM servia. O proxy.sh a copia de
# /var/www/html/index.html antes de parar o apache, entao quem chegava por IP
# ve exatamente o mesmo de antes.
# ---------------------------------------------------------------------------
:80 {
	root * /srv/publico
	file_server
}
