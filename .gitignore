# Certificado e chave do proxy: distribuidos em tempo de execucao,
# nunca versionados.
*.pem
*.key
cert/
# Gerado pelo proxy.sh a partir do nome do aluno.
Caddyfile

.env
.DS_Store

# Soma do Caddyfile+certificado, para saber quando reiniciar o Caddy.
.soma_caddy
.tunel_segredo

# Saida do emitir-cert.sh: certificado e chave da turma, nunca versionados.
cert-*/
cert.bak/
